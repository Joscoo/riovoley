{"function" : "restore_payment(bigint)", "security_definer" : true, "anon_execute" : true, "authenticated_execute" : true, "definition" : "CREATE OR REPLACE FUNCTION public.restore_payment(payment_id bigint)\n RETURNS boolean\n LANGUAGE plpgsql\n SECURITY DEFINER\nAS $function$\r\nBEGIN\r\n  UPDATE payments\r\n  SET deleted_at = NULL\r\n  WHERE id = payment_id AND deleted_at IS NOT NULL;\r\n  \r\n  RETURN FOUND;\r\nEND;\r\n$function$\n"}
{"function" : "restore_payment(uuid)", "security_definer" : true, "anon_execute" : true, "authenticated_execute" : true, "definition" : "CREATE OR REPLACE FUNCTION public.restore_payment(payment_id uuid)\n RETURNS boolean\n LANGUAGE plpgsql\n SECURITY DEFINER\nAS $function$\r\nBEGIN\r\n  UPDATE payments\r\n  SET deleted_at = NULL\r\n  WHERE id = payment_id AND deleted_at IS NOT NULL;\r\n  \r\n  RETURN FOUND;\r\nEND;\r\n$function$\n"}
{"function" : "soft_delete_payment(bigint)", "security_definer" : true, "anon_execute" : true, "authenticated_execute" : true, "definition" : "CREATE OR REPLACE FUNCTION public.soft_delete_payment(payment_id bigint)\n RETURNS boolean\n LANGUAGE plpgsql\n SECURITY DEFINER\nAS $function$\r\nBEGIN\r\n  UPDATE payments\r\n  SET deleted_at = NOW()\r\n  WHERE id = payment_id AND deleted_at IS NULL;\r\n  \r\n  RETURN FOUND;\r\nEND;\r\n$function$\n"}
