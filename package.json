{
  "name": "riovoley",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/cli": "^8.4.0",
    "@capacitor/core": "^8.4.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.1",
    "@capacitor/share": "^8.0.1",
    "@capgo/capacitor-updater": "^8.47.9",
    "@supabase/supabase-js": "^2.74.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^13.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gapi-script": "^1.2.0",
    "icons": "^1.0.0",
    "jspdf": "^4.2.0",
    "jspdf-autotable": "^5.0.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.7.0",
    "react-scripts": "5.0.1",
    "recharts": "^3.3.0",
    "tailwind-merge": "^3.5.0",
    "web-vitals": "^2.1.4",
    "@riovoley/minimatch-engine": "npm:minimatch@11.0.3",
    "minimatch": "file:vendor/minimatch-compat",
    "deepmerge": "file:vendor/deepmerge"
  },
  "devDependencies": {
    "@playwright/test": "^1.53.0",
    "autoprefixer": "^10.5.0",
    "cross-env": "^10.1.0",
    "postcss": "^8.5.9",
    "tailwindcss": "^3.4.13"
  },
  "overrides": {
    "express": {
      "qs": "6.16.2"
    },
    "jsonpath": {
      "underscore": "1.13.8"
    },
    "serialize-javascript": "7.1.4",
    "http-proxy-agent": {
      "@tootallnate/once": "2.0.1"
    },
    "@svgr/webpack": "6.5.1",
    "resolve-url-loader": "5.0.0",
    "webpack-dev-server": "6.1.0",
    "deepmerge": "$deepmerge",
    "minimatch": "$minimatch",
    "glob@>=9.0.0 <14.0.2": "14.0.3"
  },
  "scripts": {
    "start": "node scripts/toolchain/start.cjs",
    "build": "cross-env CI=false react-scripts build",
    "mobile:sync": "npm run build && npx cap sync",
    "mobile:android": "npm run mobile:sync && npx cap open android",
    "ota:upload:production": "npm run build && npx @capgo/cli@latest bundle upload com.riovoley.app --path ./build --channel production",
    "ota:upload:beta": "npm run build && npx @capgo/cli@latest bundle upload com.riovoley.app --path ./build --channel beta",
    "check:copy-quality": "node scripts/copyQualityCheck.js",
    "test": "react-scripts test",
    "check:production": "node scripts/production/preflight.cjs",
    "test:toolchain": "node --test --test-concurrency=1 tests/integration/toolchain.dependencies.test.cjs tests/integration/toolchain.security-followup.test.cjs tests/integration/toolchain.loaders-security.test.cjs tests/integration/toolchain.production-readiness.test.cjs tests/unit/dev-server-config.test.cjs tests/unit/production-preflight.test.cjs tests/integration/toolchain.patterns.test.cjs",
    "test:auth-edge": "node functions/node_modules/tsx/dist/cli.mjs --test tests/unit/credentials-edge.test.ts",
    "test:edge-contracts": "node functions/node_modules/tsx/dist/cli.mjs --test --test-reporter=tap tests/unit/credentials-edge.test.ts tests/unit/authorization-edge.test.ts tests/unit/reporting-edge.test.cjs tests/unit/payment-reminders-edge.test.cjs tests/unit/edge-relations.test.ts",
    "test:contracts": "cross-env CI=true react-scripts test src/features/reporting/infrastructure/repositories/supabaseReportingRepository.contract.test.js src/shared/infrastructure/auth/deleteAuthUserById.test.js",
    "eject": "react-scripts eject",
    "e2e": "playwright test",
    "e2e:local:setup": "node scripts/e2e/local/manage.cjs setup",
    "e2e:local:start": "node scripts/e2e/local/manage.cjs start",
    "e2e:local:stop": "node scripts/e2e/local/manage.cjs stop",
    "e2e:local:build": "node scripts/e2e/local/build.cjs",
    "e2e:local:smoke": "node scripts/e2e/local/run.cjs smoke",
    "e2e:local:pending": "node scripts/e2e/local/run.cjs pending",
    "e2e:local:mutations": "node scripts/e2e/local/run.cjs mutations",
    "e2e:local:guards": "node --test scripts/e2e/local/safety.test.cjs scripts/e2e/local/schema.test.cjs scripts/e2e/local/loopback.test.cjs scripts/e2e/local/evidence.test.cjs",
    "e2e:smoke:roles": "playwright test tests/e2e/roles.panels-navigation.smoke.spec.js --project=desktop-1440",
    "e2e:smoke:roles:strict": "node scripts/e2e/runRolesSmokeStrict.js",
    "e2e:filters-sorting": "playwright test tests/e2e/filters-sorting.tables.spec.js --project=desktop-1440",
    "e2e:filters-sorting:users": "playwright test tests/e2e/filters-sorting.user-management.spec.js --project=desktop-1440",
    "e2e:filters-sorting:phase2": "playwright test tests/e2e/filters-sorting.phase2-lists.spec.js --project=desktop-1440",
    "e2e:filters-sorting:physical": "playwright test tests/e2e/filters-sorting.physical-tests.spec.js --project=desktop-1440",
    "e2e:filters-sorting:all": "playwright test tests/e2e/filters-sorting.tables.spec.js tests/e2e/filters-sorting.user-management.spec.js tests/e2e/filters-sorting.phase2-lists.spec.js tests/e2e/filters-sorting.physical-tests.spec.js --project=desktop-1440",
    "e2e:smoke:public": "playwright test tests/e2e/responsive.smoke.spec.js --project=desktop-1440 --grep \"public route responsive guard\"",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
